# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# OS
.DS_Store
Thumbs.db

# Large dataset (user-provided) — keep only the synthetic sample
data/raw/*
!data/raw/sample_jobs.csv

